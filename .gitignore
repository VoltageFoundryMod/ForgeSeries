
# Aggregate VCV plugin: staged panels and build output.
# vcv/apps/ is generated too: Rack's compile.mk derives object paths from source
# paths, and the sources are ../apps/..., so build/../apps/... normalises to
# vcv/apps/... rather than staying under build/.
vcv/res/
vcv/build/
vcv/apps/
vcv/dist/
vcv/plugin.dll
vcv/plugin.so
vcv/plugin.dylib
# A literal "~" directory. PlatformIO writes into $HOME, and when HOME is unset
# or mis-expanded (some msys/Git-Bash invocations) it creates ./~/ containing a
# full package cache — 1400+ files, including embedded git repos. Never ours.
~/

# VCV Rack plugin build output
**/vcv-plugin/build/
**/vcv-plugin/dist/
**/vcv-plugin/plugin.dll
**/vcv-plugin/plugin.so
**/vcv-plugin/plugin.dylib

.pio
CURRENT.UF2

# Scratch space for build intermediates — .build/panels/ holds each panel SVG
# after the guide layers and clones are resolved but before Inkscape outlines
# the text. The committed artefact is apps/<app>/vcv-plugin/res/<Name>.svg.
.build/

# PlatformIO regenerates both of these into the project root, which is now the
# repo root. They hold absolute toolchain and home-directory paths, so they are
# per-machine and must not be committed. tasks.json and extensions.json are
# hand-written and stay tracked.
.vscode/c_cpp_properties.json
.vscode/launch.json
