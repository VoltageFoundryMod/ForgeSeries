{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build PlatformIO Project",
      "type": "shell",
      "command": "platformio",
      "args": [
        "run"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Upload Firmware to XIAO RP2040",
      "type": "shell",
      "command": "./scripts/uploadFirmware.sh",
      "args": [
        "${workspaceFolder}/.pio/build/xiao_rp2040/firmware.uf2"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "dependsOn": "Build PlatformIO Project"
    },
    {
      "label": "Firmware: Native Tests",
      "type": "shell",
      "command": "pio",
      "args": [
        "test",
        "-e",
        "native"
      ],
      "options": {
        "env": {
          "PATH": "/c/msys64/mingw64/bin:${env:PATH}"
        }
      },
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "VCV Plugin: Build and Install",
      "type": "shell",
      "command": "make",
      "args": [
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vcv-plugin",
        "env": {
          "PATH": "/c/msys64/usr/bin:/c/msys64/mingw64/bin:${env:PATH}",
          "MSYSTEM": "MINGW64"
        }
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "VCV Plugin: Clean",
      "type": "shell",
      "command": "make",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vcv-plugin",
        "env": {
          "PATH": "/c/msys64/usr/bin:/c/msys64/mingw64/bin:${env:PATH}",
          "MSYSTEM": "MINGW64"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "VCV Plugin: Isolation Test",
      "type": "shell",
      "command": "test/build_isolation_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/vcv-plugin",
        "env": {
          "PATH": "/c/msys64/usr/bin:/c/msys64/mingw64/bin:${env:PATH}",
          "MSYSTEM": "MINGW64"
        }
      },
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
