// engine_state.def — THE registry of per-instance firmware state.
//
// Every mutable file-scope global the firmware (../lib + fw_engine.cpp) carries
// is listed here exactly once.  The list is expanded three times by
// fw_engine.cpp — to declare the EngineState mirror struct, to swap globals with
// state, and to deep-copy globals into a pristine snapshot — so adding a
// firmware global means adding ONE line here, not editing three hand-synced
// code sites.
//
// Macros (define before #include-ing this file; all are #undef'd by the includer):
//   CF_SCALAR(type, name)          a scalar global (type is the *non-volatile*
//                                  storage type; volatile globals list their
//                                  base type, e.g. `bool trigPending`).
//   CF_ARRAY(type, name, count)    a C array of scalars.
//   CF_OBJECT(type, name)          a default-constructible, swappable object.
//   CF_OBJARRAY(type, name, count) an array of such objects.
//
// NOT listed here (deliberately shared, safe under the entry-point lock):
//   • displayMgr / display — scratch: re-rendered on every getFramebuffer().
//   • const description arrays, MENU_ITEMS, scale tables — immutable.
//   • the one-time shim setup (interrupt vector, display.begin, InitDAC).

// ── Quantizer voices (../lib/channel.hpp) ────────────────────────────────────
// The whole DSP state of the module: note masks, scale/root, pitch offsets,
// glide, sync policy and both envelopes live inside these two objects.
CF_OBJARRAY(QuantizerChannel, channels, NUM_CHANNELS)

// ── CV / TRIG inputs (../lib/cvInputs.hpp) ───────────────────────────────────
CF_ARRAY (float,         channelADC,    NUM_CV_INS)
CF_ARRAY (float,         oldChannelADC, NUM_CV_INS)
CF_SCALAR(bool,          trigPending)   // volatile global
CF_SCALAR(unsigned long, lastTrigUs)    // volatile global
CF_SCALAR(bool,          trigSeen)      // volatile global
CF_SCALAR(bool,          trigLevel)     // volatile global

// ── IN 2 routing / transposition (../lib/cvInputs.hpp) ───────────────────────
CF_SCALAR(unsigned char, in2Role)
CF_SCALAR(unsigned char, transposeRange)
CF_SCALAR(int,           transposeDegrees)

// ── Presets (../lib/presetManager.hpp) ───────────────────────────────────────
CF_SCALAR(int, saveSlot)

// ── Menu / UI (fw_engine.cpp file-scope) ─────────────────────────────────────
CF_SCALAR(int,  menuItem)
CF_SCALAR(bool, switchState)
CF_SCALAR(bool, oldSwitchState)
CF_SCALAR(int,  menuMode)
CF_SCALAR(bool, displayRefresh)
CF_SCALAR(bool, unsavedChanges)
CF_SCALAR(int,  menuScreenTimeout)

// ── Objects (default-constructible, swappable) ───────────────────────────────
CF_OBJECT(CalibrationData, cal)
CF_OBJECT(EEPROMClass,     EEPROM) // per-instance presets/calibration blob

// ── Engine time + on-screen message overlay (fw_engine.cpp file-scope) ───────
CF_SCALAR(unsigned long, g_engineMicros)
CF_ARRAY (char,          _tempMsg, 32)
CF_SCALAR(unsigned long, _tempMsgUntil)
