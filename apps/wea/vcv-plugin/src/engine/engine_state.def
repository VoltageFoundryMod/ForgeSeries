// engine_state.def — THE registry of per-instance firmware state.
//
// Every mutable file-scope global the firmware (../lib + fw_engine.cpp) carries
// is listed here exactly once. The list is expanded three times by
// fw_engine.cpp — to declare the EngineState mirror struct, to swap globals with
// state, and to deep-copy globals into a pristine snapshot — so adding a
// firmware global means adding ONE line here, not editing three hand-synced
// code sites.
//
// test/build_isolation_test.sh is the guard. On this module the failure it
// catches is unusually obvious: an unregistered register means two WeaveForges
// playing the identical pattern.
//
// Macros (define before #include-ing this file; all are #undef'd by the includer):
//   CF_SCALAR(type, name)          a scalar global (type is the *non-volatile*
//                                  storage type; volatile globals list their
//                                  base type, e.g. `bool trigPending`).
//   CF_ARRAY(type, name, count)    a C array of scalars.
//   CF_OBJECT(type, name)          a default-constructible, swappable object.
//   CF_OBJARRAY(type, name, count) an array of such objects.
//
// NOT listed here (deliberately shared, safe under the entry-point lock):
//   • displayMgr / display — scratch: re-rendered on every getFramebuffer().
//   • _md_rowY (menuDisplay.hpp) — scratch within a single render pass.
//   • const tables — MENU_ITEMS, ROUTING_TEMPLATES, the scale tables.

// ── The machine (../lib/shiftreg.hpp) ────────────────────────────────────────
// Both registers, their lengths and the weave PRNG live inside this one object.
// If exactly one line in this file matters, it is this one.
CF_OBJECT(WeavePair, registers)

// ── The jacks (../lib/outputs.hpp) ───────────────────────────────────────────
// The four slots AND their runtime state (gate levels, trigger deadlines, slew).
CF_OBJECT(OutputBank, outputs)

// ── Clock and pitch ──────────────────────────────────────────────────────────
CF_OBJECT(StepClock, clockEngine)
CF_OBJECT(Quantizer, quantizer)

// ── Base parameters (../lib/params.hpp) ──────────────────────────────────────
// What the *user* set, as opposed to what the engine is currently running with
// CV modulation applied. These are what presets store.
CF_OBJARRAY(RegParams, regParams, WEA_NUM_REGS)
CF_OBJECT (GlobalParams, globalParams)
CF_OBJECT (ModBus,       modBus)
CF_OBJECT (LiveParams,   liveParams)

// The RESET target's edge detector. Shared, one instance's gate going high
// would arm the other's — and then neither would reset again until both fell.
CF_SCALAR(bool, resetArmed)

// ── Scale (fw_engine.cpp file-scope) ─────────────────────────────────────────
CF_SCALAR(uint16_t, noteMask)
CF_SCALAR(uint8_t,  scaleIndex)
CF_SCALAR(uint8_t,  rootIndex)

// ── CV / IN 1 inputs (../lib/cvInputs.hpp) ───────────────────────────────────
CF_ARRAY (float,         channelCv,    NUM_CV_INS)
CF_ARRAY (float,         oldChannelCv, NUM_CV_INS)
CF_ARRAY (uint8_t,       cvTarget,     NUM_CV_INS)
CF_ARRAY (uint8_t,       cvDepth,      NUM_CV_INS)
CF_SCALAR(bool,          trigPending)  // volatile global
CF_SCALAR(unsigned long, lastTrigUs)   // volatile global
CF_SCALAR(bool,          trigSeen)     // volatile global
CF_SCALAR(unsigned long, trigEdgeUs)   // volatile global

// ── Presets (../lib/presetManager.hpp) ───────────────────────────────────────
CF_SCALAR(int, saveSlot)

// ── The randomiser's PRNG (../lib/randomize.hpp) ─────────────────────────────
// Registered here, unlike ChaosForge's, and the difference is deliberate. That
// module only draws from _rndGen through RandomizeParams(), which re-seeds on
// every call, so sharing it costs nothing. WeaveForge also draws from it in the
// per-register RANDOMIZE menu action, which does NOT re-seed — so two instances
// sharing one stream would have the second one's rolled pattern depend on how
// many times the first had been rolled.
CF_OBJECT(WeaveRandom, _rndGen)

// ── Menu / UI (fw_engine.cpp file-scope) ─────────────────────────────────────
CF_SCALAR(int,  menuItem)
CF_SCALAR(bool, switchState)
CF_SCALAR(bool, oldSwitchState)
CF_SCALAR(int,  menuMode)
CF_SCALAR(bool, displayRefresh)
CF_SCALAR(bool, unsavedChanges)
CF_SCALAR(int,  menuScreenTimeout)
// The live loom view's hold-off deadline (../lib/menuHandlers.hpp). Shared, two
// Rack instances would yank each other's screen between the menu and the loom.
CF_SCALAR(unsigned long, liveViewUntil)

// ── Objects (default-constructible, swappable) ───────────────────────────────
CF_OBJECT(CalibrationData, cal)
CF_OBJECT(EEPROMClass,     EEPROM) // per-instance presets/calibration blob

// ── Engine time + on-screen message overlay (fw_engine.cpp file-scope) ───────
CF_SCALAR(unsigned long, g_engineMicros)
CF_ARRAY (char,          _tempMsg, 32)
CF_SCALAR(unsigned long, _tempMsgUntil)
